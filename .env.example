# SubFlow 语幕 — 复制为 .env 后填入（不要提交 .env）
# docker compose pull 拉取已发布的 CPU 镜像（amd64 / arm64）
SUBFLOW_IMAGE=crazymsn/subflow:1.3.46
SUBFLOW_CPU_THREADS=4
SUBFLOW_GPTSOVITS_TIMEOUT=1800
SUBFLOW_API_KEY=
# 可选：保存 key 后先 docker compose run --rm subflow models 查看列表
SUBFLOW_TRANSLATE_MODEL=
HF_ENDPOINT=https://huggingface.co
